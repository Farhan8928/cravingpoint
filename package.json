{
  "name": "craving-point",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official website for Craving Point .88 — dessert atelier & grill, Trombay, Mumbai",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/process-frames.mjs && node scripts/process-images.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "assets:frames": "node scripts/process-frames.mjs",
    "assets:images": "node scripts/process-images.mjs",
    "audit": "node scripts/audit-contrast.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run audit && npm run smoke"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
